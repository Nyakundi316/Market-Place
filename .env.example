# Copy to .env and fill in. Validated at boot by packages/shared/src/env.ts (§12).
NODE_ENV=development
PORT=3001
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001

DATABASE_URL=postgresql://markethub:markethub@localhost:5432/markethub?schema=public
DATABASE_URL_TEST=postgresql://markethub:markethub@localhost:5432/markethub_test?schema=public
REDIS_URL=redis://localhost:6379

# ≥32 chars each, rotate every 90 days (§9). Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# OAuth — optional outside production; a provider is disabled when its pair is empty
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Production mail. In development mail goes to Mailhog over SMTP instead.
RESEND_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="MarketHub <no-reply@markethub.local>"
FCM_SERVER_KEY=

PLATFORM_FEE_PERCENT=2
ESCROW_AUTO_RELEASE_HOURS=72
DISPUTE_WINDOW_DAYS=7

# Seed only (1.6)
SEED_ADMIN_EMAIL=admin@markethub.local
SEED_ADMIN_PASSWORD=
