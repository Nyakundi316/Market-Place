// MarketHub schema — source of truth is PROJECT_BRIEF.md §3.
// Tables/columns are snake_case in Postgres, camelCase in TS.
// Raw-SQL pieces (triggers, partial/GIN indexes) live in migrations, see 1.5.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext, pg_trgm]
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum UserRole {
  seller
  buyer
  both
  admin
}

enum ListingType {
  product
  service
  job
  request
}

enum ListingStatus {
  draft
  pending
  active
  sold
  expired
  removed
}

enum MessageType {
  text
  image
  file
  system
  offer
  offer_response
}

enum OfferStatus {
  pending
  accepted
  declined
  countered
  expired
  withdrawn
}

enum OrderStatus {
  awaiting_payment
  paid
  in_escrow
  shipped
  delivered
  completed
  disputed
  refunded
  cancelled
}

enum EscrowStatus {
  held
  released
  refunded
  partially_refunded
  disputed
}

enum TxnType {
  charge
  payout
  refund
  fee
  chargeback
}

enum TxnStatus {
  pending
  succeeded
  failed
  reversed
}

/// Extra (documented in PROJECT_BRIEF §3 addendum): purposes for AuthToken
enum AuthTokenType {
  email_verify
  password_reset
}

// ─── Identity ───────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique @db.Citext
  phone           String?
  passwordHash    String?   @map("password_hash") // null for OAuth-only accounts
  role            UserRole  @default(buyer)
  isEmailVerified Boolean   @default(false) @map("is_email_verified")
  isPhoneVerified Boolean   @default(false) @map("is_phone_verified")
  isActive        Boolean   @default(true) @map("is_active")
  isBanned        Boolean   @default(false) @map("is_banned")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  profile       Profile?
  oauthAccounts OAuthAccount[]
  refreshTokens RefreshToken[]
  authTokens    AuthToken[]
  listings      Listing[]
  following     Follow[]       @relation("follower")
  followers     Follow[]       @relation("following")
  favorites     Favorite[]

  buyerConversations  Conversation[] @relation("conversationBuyer")
  sellerConversations Conversation[] @relation("conversationSeller")
  messages            Message[]
  offersSent          Offer[]        @relation("offerFrom")
  offersReceived      Offer[]        @relation("offerTo")
  purchases           Order[]        @relation("orderBuyer")
  sales               Order[]        @relation("orderSeller")
  transactions        Transaction[]
  reviewsGiven        Review[]       @relation("reviewRater")
  reviewsReceived     Review[]       @relation("reviewRatee")
  notifications       Notification[]
  auditLogs           AuditLog[]
  reportsFiled        Report[]       @relation("reportReporter")
  reportsResolved     Report[]       @relation("reportResolver")

  @@map("users")
}

model OAuthAccount {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  provider    String
  providerUid String   @map("provider_uid")
  tokens      Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUid])
  @@index([userId])
  @@map("oauth_accounts")
}

/// Extra (§9): hashed, single-use, rotated. Reuse of a used token revokes its whole family.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Extra (§9): email-verify and password-reset links. Only the hash is stored.
model AuthToken {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique @map("token_hash")
  expiresAt DateTime      @map("expires_at")
  usedAt    DateTime?     @map("used_at")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

model Profile {
  userId           String   @id @map("user_id") @db.Uuid
  displayName      String   @map("display_name")
  username         String   @unique @db.Citext
  avatarUrl        String?  @map("avatar_url")
  coverUrl         String?  @map("cover_url")
  bio              String?
  profession       String?
  company          String?
  website          String?
  country          String?  @db.Char(2)
  city             String?
  socials          Json     @default("{}")
  idVerified       Boolean  @default(false) @map("id_verified")
  businessVerified Boolean  @default(false) @map("business_verified")
  ratingAvg        Decimal  @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount      Int      @default(0) @map("rating_count")
  listingsCount    Int      @default(0) @map("listings_count")
  completedDeals   Int      @default(0) @map("completed_deals")
  responseRate     Decimal  @default(0) @map("response_rate") @db.Decimal(5, 2)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([country])
  @@map("profiles")
}

model Follow {
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

// ─── Catalog ────────────────────────────────────────────────────────────────

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid
  name        String
  slug        String   @unique
  icon        String?
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent   Category?  @relation("tree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("tree")
  listings Listing[]

  @@index([parentId, sortOrder])
  @@map("categories")
}

model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  slug      String   @unique
  useCount  Int      @default(0) @map("use_count")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  listings ListingTag[]

  @@map("tags")
}

model Listing {
  id             String                   @id @default(uuid()) @db.Uuid
  sellerId       String                   @map("seller_id") @db.Uuid
  categoryId     String                   @map("category_id") @db.Uuid
  type           ListingType
  status         ListingStatus            @default(draft)
  title          String
  slug           String                   @unique
  description    String
  price          Decimal?                 @db.Decimal(14, 2)
  currency       String                   @db.Char(3)
  isNegotiable   Boolean                  @default(true) @map("is_negotiable")
  isPriceRange   Boolean                  @default(false) @map("is_price_range")
  priceMin       Decimal?                 @map("price_min") @db.Decimal(14, 2)
  priceMax       Decimal?                 @map("price_max") @db.Decimal(14, 2)
  stock          Int?
  condition      String?
  country        String?                  @db.Char(2)
  city           String?
  lat            Decimal?                 @db.Decimal(9, 6)
  lng            Decimal?                 @db.Decimal(9, 6)
  contactPref    String?                  @map("contact_pref")
  viewsCount     Int                      @default(0) @map("views_count")
  favoritesCount Int                      @default(0) @map("favorites_count")
  chatCount      Int                      @default(0) @map("chat_count")
  isFeatured     Boolean                  @default(false) @map("is_featured")
  featuredUntil  DateTime?                @map("featured_until")
  publishedAt    DateTime?                @map("published_at")
  expiresAt      DateTime?                @map("expires_at")
  searchVector   Unsupported("tsvector")? @map("search_vector") // set by trigger, see 1.5
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")

  seller        User           @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images        ListingImage[]
  tags          ListingTag[]
  favorites     Favorite[]
  conversations Conversation[]
  offers        Offer[]
  orders        Order[]

  // Partial (category WHERE active) index is raw SQL in the
  // search_triggers_constraints migration; GIN(search_vector) is created there too.
  @@index([sellerId])
  @@index([status])
  @@index([price])
  @@index([country, city])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "listings_title_trgm_idx")
  @@index([searchVector], type: Gin, map: "listings_search_vector_idx")
  @@map("listings")
}

model ListingImage {
  id        String   @id @default(uuid()) @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  url       String
  thumbUrl  String?  @map("thumb_url")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, sortOrder])
  @@map("listing_images")
}

model ListingTag {
  listingId String   @map("listing_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([listingId, tagId])
  @@index([tagId])
  @@map("listing_tags")
}

model Favorite {
  userId    String   @map("user_id") @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@index([listingId])
  @@map("favorites")
}

// ─── Chat & offers ──────────────────────────────────────────────────────────

model Conversation {
  id            String    @id @default(uuid()) @db.Uuid
  listingId     String    @map("listing_id") @db.Uuid
  buyerId       String    @map("buyer_id") @db.Uuid
  sellerId      String    @map("seller_id") @db.Uuid
  lastMessageAt DateTime? @map("last_message_at")
  // Plain column, not a relation: set by trigger (1.5) and avoids a Conversation↔Message cycle.
  lastMessageId String?   @map("last_message_id") @db.Uuid
  buyerUnread   Int       @default(0) @map("buyer_unread")
  sellerUnread  Int       @default(0) @map("seller_unread")
  isArchived    Boolean   @default(false) @map("is_archived")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  listing  Listing   @relation(fields: [listingId], references: [id], onDelete: Restrict)
  buyer    User      @relation("conversationBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  seller   User      @relation("conversationSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  messages Message[]
  offers   Offer[]

  @@unique([listingId, buyerId, sellerId])
  @@index([buyerId, lastMessageAt(sort: Desc)])
  @@index([sellerId, lastMessageAt(sort: Desc)])
  @@map("conversations")
}

/// Immutable apart from read state, so createdAt only (§3).
model Message {
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  senderId       String      @map("sender_id") @db.Uuid
  type           MessageType @default(text)
  body           String? // stored raw, escaped on render (§5)
  attachments    Json        @default("[]")
  offerId        String?     @map("offer_id") @db.Uuid
  isRead         Boolean     @default(false) @map("is_read")
  readAt         DateTime?   @map("read_at")
  createdAt      DateTime    @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Restrict)
  offer        Offer?       @relation(fields: [offerId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt(sort: Desc)])
  @@map("messages")
}

/// A counter-offer is a new row pointing at its parent; the parent becomes `countered`.
model Offer {
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  listingId      String      @map("listing_id") @db.Uuid
  fromUserId     String      @map("from_user_id") @db.Uuid
  toUserId       String      @map("to_user_id") @db.Uuid
  parentOfferId  String?     @map("parent_offer_id") @db.Uuid
  quantity       Int         @default(1)
  unitPrice      Decimal     @map("unit_price") @db.Decimal(14, 2)
  totalPrice     Decimal     @map("total_price") @db.Decimal(14, 2)
  currency       String      @db.Char(3)
  message        String?
  status         OfferStatus @default(pending)
  expiresAt      DateTime?   @map("expires_at")
  respondedAt    DateTime?   @map("responded_at")
  createdAt      DateTime    @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  listing      Listing      @relation(fields: [listingId], references: [id], onDelete: Restrict)
  fromUser     User         @relation("offerFrom", fields: [fromUserId], references: [id], onDelete: Restrict)
  toUser       User         @relation("offerTo", fields: [toUserId], references: [id], onDelete: Restrict)
  parent       Offer?       @relation("counter", fields: [parentOfferId], references: [id], onDelete: Restrict)
  counters     Offer[]      @relation("counter")
  messages     Message[]
  order        Order?

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([toUserId, status])
  @@index([fromUserId, status])
  @@map("offers")
}

// ─── Orders ─────────────────────────────────────────────────────────────────

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  orderNumber     String      @unique @map("order_number") // ORD-YYYY-NNNNNN
  listingId       String      @map("listing_id") @db.Uuid
  // Unique: one accepted offer yields at most one order (documented extra).
  offerId         String?     @unique @map("offer_id") @db.Uuid
  buyerId         String      @map("buyer_id") @db.Uuid
  sellerId        String      @map("seller_id") @db.Uuid
  quantity        Int
  unitPrice       Decimal     @map("unit_price") @db.Decimal(14, 2)
  subtotal        Decimal     @db.Decimal(14, 2)
  platformFee     Decimal     @map("platform_fee") @db.Decimal(14, 2)
  total           Decimal     @db.Decimal(14, 2)
  currency        String      @db.Char(3)
  status          OrderStatus @default(awaiting_payment)
  deliveryMethod  String?     @map("delivery_method")
  deliveryAddress Json?       @map("delivery_address")
  trackingNumber  String?     @map("tracking_number")
  notes           String?
  paidAt          DateTime?   @map("paid_at")
  deliveredAt     DateTime?   @map("delivered_at")
  completedAt     DateTime?   @map("completed_at")
  cancelledAt     DateTime?   @map("cancelled_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  offer   Offer?  @relation(fields: [offerId], references: [id], onDelete: Restrict)
  buyer   User    @relation("orderBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  seller  User    @relation("orderSeller", fields: [sellerId], references: [id], onDelete: Restrict)

  escrow       EscrowHold?
  transactions Transaction[]
  review       Review?

  @@index([buyerId, createdAt(sort: Desc)])
  @@index([sellerId, createdAt(sort: Desc)])
  @@index([listingId])
  @@index([status])
  @@map("orders")
}

// ─── Money (§7) ─────────────────────────────────────────────────────────────
// Rows here are never deleted; corrections are new refund/reversal rows.

model EscrowHold {
  id                 String       @id @default(uuid()) @db.Uuid
  orderId            String       @unique @map("order_id") @db.Uuid
  amount             Decimal      @db.Decimal(14, 2)
  currency           String       @db.Char(3)
  status             EscrowStatus @default(held)
  heldAt             DateTime     @default(now()) @map("held_at")
  releaseScheduledAt DateTime?    @map("release_scheduled_at")
  releasedAt         DateTime?    @map("released_at")
  refundedAt         DateTime?    @map("refunded_at")
  disputeReason      String?      @map("dispute_reason")
  notes              String?
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([status, releaseScheduledAt])
  @@map("escrow_holds")
}

model Transaction {
  id             String    @id @default(uuid()) @db.Uuid
  orderId        String    @map("order_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  type           TxnType
  status         TxnStatus @default(pending)
  amount         Decimal   @db.Decimal(14, 2)
  currency       String    @db.Char(3)
  gateway        String // "stripe" | "paystack"
  gatewayRef     String?   @map("gateway_ref")
  gatewayPayload Json?     @map("gateway_payload") // never exposed (§9)
  idempotencyKey String    @unique @map("idempotency_key")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at") // documented extra: status moves pending→terminal

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([gatewayRef])
  @@map("transactions")
}

// ─── Trust ──────────────────────────────────────────────────────────────────

/// CHECKs (rating 1–5, rater ≠ ratee) are raw SQL in 1.5.
model Review {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @unique @map("order_id") @db.Uuid
  raterId   String   @map("rater_id") @db.Uuid
  rateeId   String   @map("ratee_id") @db.Uuid
  rating    Int      @db.SmallInt
  comment   String?
  isVisible Boolean  @default(true) @map("is_visible")
  createdAt DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  rater User  @relation("reviewRater", fields: [raterId], references: [id], onDelete: Restrict)
  ratee User  @relation("reviewRatee", fields: [rateeId], references: [id], onDelete: Restrict)

  @@index([rateeId, createdAt(sort: Desc)])
  @@map("reviews")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  title     String
  body      String?
  link      String?
  payload   Json?
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@map("notifications")
}

/// Append-only, so createdAt only. actorId null = system/job.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model Report {
  id         String    @id @default(uuid()) @db.Uuid
  reporterId String    @map("reporter_id") @db.Uuid
  entityType String    @map("entity_type") // "listing" | "user" | "message" | "review"
  entityId   String    @map("entity_id")
  reason     String
  details    String?
  status     String    @default("open") // open | resolved | dismissed
  resolvedBy String?   @map("resolved_by") @db.Uuid
  resolvedAt DateTime? @map("resolved_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  reporter User  @relation("reportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  resolver User? @relation("reportResolver", fields: [resolvedBy], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("reports")
}
