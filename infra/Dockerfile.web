# syntax=docker/dockerfile:1.7
# MarketHub web (Next.js standalone). Build from the repo root:
#   docker build -f infra/Dockerfile.web --build-arg API_URL=https://api.example.com \
#     --build-arg WEB_URL=https://example.com -t markethub-web .
# API_URL and NEXT_PUBLIC_* are baked in at build time; the rest is read at runtime.

ARG NODE_VERSION=22
FROM node:${NODE_VERSION}-bookworm-slim AS base
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH CI=1 NEXT_TELEMETRY_DISABLED=1 NEXT_OUTPUT=standalone
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

FROM base AS prune
COPY . .
RUN pnpm dlx turbo@2.11.7 prune web --docker

FROM base AS build
COPY --from=prune /app/out/json/ .
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile
COPY --from=prune /app/out/full/ .
# Public values only — never pass secrets as build args.
ARG API_URL
ARG WEB_URL
ARG NEXT_PUBLIC_SENTRY_DSN=""
ARG GIT_SHA=""
ENV API_URL=$API_URL WEB_URL=$WEB_URL NEXT_PUBLIC_SENTRY_DSN=$NEXT_PUBLIC_SENTRY_DSN \
    NEXT_PUBLIC_GIT_SHA=$GIT_SHA GIT_SHA=$GIT_SHA
RUN test -n "$API_URL" -a -n "$WEB_URL" || (echo "API_URL and WEB_URL build args are required" && exit 1)
RUN pnpm turbo run build --filter=web

FROM node:${NODE_VERSION}-bookworm-slim AS runner
RUN apt-get update && apt-get install -y --no-install-recommends tini ca-certificates \
  && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
WORKDIR /app
COPY --from=build --chown=node:node /app/apps/web/.next/standalone ./
COPY --from=build --chown=node:node /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=node:node /app/apps/web/public ./apps/web/public
USER node
EXPOSE 3000
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "apps/web/server.js"]
