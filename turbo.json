{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", "PROJECT_BRIEF.md"],
  "tasks": {
    "build":     {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["API_URL", "API_INTERNAL_URL"]
    },
    "dev":       { "cache": false, "persistent": true },
    "test":      { "dependsOn": ["^build"], "outputs": ["coverage/**"] },
    "test:e2e":  {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": [
        "CI", "NODE_ENV", "WEB_URL", "API_URL", "DATABASE_URL", "DATABASE_URL_TEST",
        "REDIS_URL", "REDIS_URL_TEST", "JWT_*", "E2E_*", "PLAYWRIGHT_*"
      ]
    },
    "lint":      {},
    "typecheck": { "dependsOn": ["^build"] }
  }
}
